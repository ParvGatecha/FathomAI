# Fathom AI Environment Configuration Example
# Copy this file to .env.local to enable live OpenAI models.

# OpenAI API Key (Required for live LLM generation)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Preferred model (Default: gpt-4o-mini, supports gpt-4o, gpt-4-turbo)
OPENAI_MODEL=gpt-4o-mini

# Optional: Server Port
PORT=3000
